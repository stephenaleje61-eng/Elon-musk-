rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "elonmuskspace241@gmail.com"
      );
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // Conversations media path: /conversations/{conversationId}/{fileName}
    match /conversations/{conversationId}/{fileName} {
      // Allow read to authenticated users participating or admin
      allow read: if request.auth != null;

      // Allow upload only if authenticated, valid image type and size under 5MB
      allow create: if request.auth != null && isImageFile();

      // Only Admin can delete or modify uploaded attachments
      allow delete: if isAdmin();
    }

    // Chat images folder fallback: /chat_images/{fileName}
    match /chat_images/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isImageFile();
      allow delete: if isAdmin();
    }
  }
}
