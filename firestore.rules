rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "elonmuskspace241@gmail.com";
    }

    // collection "joinRequests": { id, name, location, message, date, status: "pending" }
    match /joinRequests/{requestId} {
      allow read, write: if true;
    }

    // collection "activeChats": { id, name, location, messages: [ {from, text, date, time, imageUrl} ] }
    match /activeChats/{chatId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Permanent conversations collection (backward compatibility)
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Permanent requests collection (backward compatibility)
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Legacy collections mirror
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    match /visitors/{visitorId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /privateChats/{visitorId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /presence/{document} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
