rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if authenticated user is the designated platform administrator
    function isAdmin() {
      return (
        request.auth != null && (
          request.auth.token.email in ["elonmuskspace241@gmail.com", "stephenaleje61@gmail.com"] ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Conversations Collection:
    // Allow read/write so visitors (with persistent visitor identifier) and admins can communicate permanently
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Admins Collection: Read-only for authenticated admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Backward-compatible ActiveChats & JoinRequests collections
    match /joinRequests/{requestId} {
      allow read, write: if true;
    }

    match /activeChats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Presence Collection
    match /presence/{document} {
      allow read, write: if true;
    }

    // Default match for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
